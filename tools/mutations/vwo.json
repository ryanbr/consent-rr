{
    "resource": "extra/vwo.js",
    "test": "test/vwo.test.mjs",
    "expected": {
        "no pass as the document arrives": "the head watch catches the style first, so this pass is the belt under it - reachable only when new MutationObserver threw, which nothing in a test can make it do. Removing both is killed",
        "the timer is cleared before their finish runs": "the timer is gone either way, and the style removal already does what their finish would have done, so nothing a page can see depends on the order. Kept in the sweep because a future change that makes the reveal depend on their finish alone would make this killable"
    },
    "mutations": [
        {
            "name": "no api at all",
            "from": "    w.VWO = api;",
            "to": "    void api;"
        },
        {
            "name": "collect is missing",
            "from": "        collect: noopfn,",
            "to": "        collectt: noopfn,"
        },
        {
            "name": "load_co injects a script",
            "from": "        load_co: noopfn,",
            "to": "        load_co: url => { const el = doc.createElement('script'); el.src = url; doc.head.appendChild(el); },"
        },
        {
            "name": "safeExecute loses the caller's this",
            "from": "            sE: fn => function() {\n                try {\n                    return fn.apply(this, arguments);",
            "to": "            sE: fn => function() {\n                try {\n                    return fn.apply(undefined, arguments);"
        },
        {
            "name": "safeExecute lets a throw out",
            "from": "                try {\n                    return fn.apply(this, arguments);\n                } catch ( ex ) {\n                }",
            "to": "                return fn.apply(this, arguments);"
        },
        {
            "name": "sets their dup-code flag",
            "from": "    const api = Array.isArray(existing) ? existing : [];",
            "to": "    w._VWO = { sCL: true };\n    const api = Array.isArray(existing) ? existing : [];"
        },
        {
            "name": "takes over from their real library",
            "from": "        typeof existing.load_co === 'function'\n    ) {\n        return;",
            "to": "        typeof existing.load_co === 'function'\n    ) {\n        void 0;"
        },
        {
            "name": "never calls their exits",
            "from": "        theirExits();",
            "to": "        void 0;"
        },
        {
            "name": "calls their overlay on every pass",
            "from": "        if ( toldThem ) { return; }",
            "to": "        if ( false ) { return; }"
        },
        {
            "name": "marks them told before finding the object",
            "from": "        if ( code === null || typeof code !== 'object' ) { return; }\n        toldThem = true;",
            "to": "        toldThem = true;\n        if ( code === null || typeof code !== 'object' ) { return; }"
        },
        {
            "name": "no overlay call",
            "from": "            try { code.removeLoaderAndOverlay(); } catch ( ex ) { }",
            "to": "            void 0;"
        },
        {
            "name": "no finish call",
            "from": "            try { code.finish(); } catch ( ex ) { }",
            "to": "            void 0;"
        },
        {
            "name": "a finish that throws escapes",
            "from": "            try { code.finish(); } catch ( ex ) { }",
            "to": "            code.finish();"
        },
        {
            "name": "only the first hiding style goes",
            "from": "            const hides = doc.querySelectorAll('#_vis_opt_path_hides');",
            "to": "            const hides = [ doc.getElementById('_vis_opt_path_hides') ];"
        },
        {
            "name": "no style removal at all",
            "from": "                el.parentNode.removeChild(el);",
            "to": "                void el;"
        },
        {
            "name": "the timer is left armed",
            "from": "        try { w.clearTimeout(w._vwo_settings_timer); } catch ( ex ) { }",
            "to": "        void 0;"
        },
        {
            "name": "the timer is cleared before their finish runs",
            "from": "    const release = ( ) => {\n        theirExits();",
            "to": "    const release = ( ) => {\n        try { w.clearTimeout(w._vwo_settings_timer); } catch ( ex ) { }\n        theirExits();"
        },
        {
            "name": "no pass at all",
            "from": "    release();\n    if ( doc.readyState !== 'loading' )",
            "to": "    if ( doc.readyState !== 'loading' )"
        },
        {
            "name": "no watch while the head arrives",
            "from": "            watch = new w.MutationObserver(release);",
            "to": "            watch = null; void w.MutationObserver;"
        },
        {
            "name": "no pass as the document arrives",
            "from": "            release();\n            ready = true;",
            "to": "            ready = true;"
        },
        {
            "name": "the watch is never stopped",
            "from": "            if ( watch !== null ) { watch.disconnect(); watch = null; }",
            "to": "            void watch;"
        },
        {
            "name": "the watch covers the parsing document",
            "from": "            watch.observe(doc.head || doc.documentElement || doc, {\n                childList: true,\n            });",
            "to": "            watch.observe(doc, { childList: true, subtree: true });"
        },
        {
            "name": "get is missing",
            "from": "        get: ( ) => '',",
            "to": "        gett: ( ) => '',"
        },
        {
            "name": "get answers undefined",
            "from": "        get: ( ) => '',",
            "to": "        get: ( ) => undefined,"
        },
        {
            "name": "init is missing",
            "from": "        init: noopfn,",
            "to": "        initt: noopfn,"
        },
        {
            "name": "event is missing",
            "from": "        event: noopfn,",
            "to": "        eventt: noopfn,"
        },
        {
            "name": "consentMode is missing",
            "from": "        consentMode: {},",
            "to": "        consentModee: {},"
        },
        {
            "name": "ssMeta reports server-side testing on",
            "from": "        ssMeta: { enabled: 0, noSS: 0 },",
            "to": "        ssMeta: { enabled: 1, noSS: 0 },"
        },
        {
            "name": "ssMeta is missing",
            "from": "        ssMeta: { enabled: 0, noSS: 0 },",
            "to": "        ssMetaa: { enabled: 0, noSS: 0 },"
        },
        {
            "name": "the internal namespace is missing",
            "from": "        _: {",
            "to": "        __: {"
        },
        {
            "name": "a plain object instead of their array shape",
            "from": "    const api = Array.isArray(existing) ? existing : [];",
            "to": "    const api = {};"
        },
        {
            "name": "a new array, throwing away what the page queued",
            "from": "    const api = Array.isArray(existing) ? existing : [];",
            "to": "    const api = [];"
        },
        {
            "name": "an absorbing push over the native one",
            "from": "    Object.assign(api, {",
            "to": "    Object.assign(api, {\n        push: noopfn,"
        },
        {
            "name": "stands aside only for a non-array library",
            "from": "        typeof existing.load_co === 'function'",
            "to": "        Array.isArray(existing) === false && typeof existing.load_co === 'function'"
        },
        {
            "name": "sets the tag-loaded flag on Wingify",
            "from": "    const api = Array.isArray(existing) ? existing : [];",
            "to": "    w.Wingify = { tagLoaded: 1 };\n    const api = Array.isArray(existing) ? existing : [];"
        },
        {
            "name": "sets tagLoaded on their object",
            "from": "        nonce: '',",
            "to": "        tagLoaded: 1,\n        nonce: '',"
        },
        {
            "name": "only the _vwo_code snippet global",
            "from": "        const code = w._vwo_code || w._wingify_code;",
            "to": "        const code = w._vwo_code;"
        },
        {
            "name": "only the _wingify_code snippet global",
            "from": "        const code = w._vwo_code || w._wingify_code;",
            "to": "        const code = w._wingify_code;"
        },
        {
            "name": "the queue is absorbed, never settled",
            "from": "        const count = queue.apply(this, args);\n        drain();",
            "to": "        const count = queue.apply(this, args);"
        },
        {
            "name": "settles even when their library is up",
            "from": "        if ( ready === false || w._vwo_s !== undefined ) { return; }",
            "to": "        if ( ready === false ) { return; }"
        },
        {
            "name": "settles before the document arrives",
            "from": "        if ( ready === false || w._vwo_s !== undefined ) { return; }",
            "to": "        if ( w._vwo_s !== undefined ) { return; }"
        },
        {
            "name": "settles the same entry on every pass",
            "from": "        while ( settled < api.length ) {",
            "to": "        settled = 0;\n        while ( settled < api.length ) {"
        },
        {
            "name": "a settled callback that throws stops the rest",
            "from": "                try { part(); } catch ( ex ) { }",
            "to": "                part();"
        },
        {
            "name": "push stops appending",
            "from": "        const count = queue.apply(this, args);",
            "to": "        const count = api.length;"
        },
        {
            "name": "no drain at DOMContentLoaded",
            "from": "            ready = true;\n            drain();",
            "to": "            ready = true;"
        }
    ]
}
